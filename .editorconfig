root = true

[*]
charset = utf-8
insert_final_newline = true
file_header_template = SPDX-FileCopyrightText:2025-2026 WithLithum\nSPDX-License-Identifier:Apache-2.0
indent_style = space
indent_size = 4

[*.json]
indent_size = 2

[*.{cs,vb}]
## Formatting
dotnet_sort_system_directives_first = true

## Naming
# styles
dotnet_naming_style.pascal_case.required_prefix =
dotnet_naming_style.pascal_case.required_suffix =
dotnet_naming_style.pascal_case.word_separator =
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.camel_case_underscore.required_prefix = _
dotnet_naming_style.camel_case_underscore.required_suffix =
dotnet_naming_style.camel_case_underscore.word_separator =
dotnet_naming_style.camel_case_underscore.capitalization = camel_case

dotnet_naming_style.s_prefix_camel_case.required_prefix = s_
dotnet_naming_style.s_prefix_camel_case.required_suffix =
dotnet_naming_style.s_prefix_camel_case.word_separator =
dotnet_naming_style.s_prefix_camel_case.capitalization = camel_case

# symbol definitions
dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private, internal

dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_fields.required_modifiers = static

dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_static_fields.required_modifiers = static

dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_constants.required_modifiers = static, const

# symbol rules
dotnet_naming_rule.private_instance_fields.symbols = private_instance_fields
dotnet_naming_rule.private_instance_fields.style = camel_case_underscore
dotnet_naming_rule.private_instance_fields.severity = suggestion

dotnet_naming_rule.private_static_fields.symbols = private_static_fields
dotnet_naming_rule.private_static_fields.style = s_prefix_camel_case
dotnet_naming_rule.private_static_fields.severity = suggestion

dotnet_naming_rule.static_fields.symbols = static_fields
dotnet_naming_rule.static_fields.style = pascal_case
dotnet_naming_rule.static_fields.severity = suggestion

dotnet_naming_rule.private_constants.style = pascal_case
dotnet_naming_rule.private_constants.severity = suggestion
dotnet_naming_rule.private_constants.symbols = private_constants


[*.cs]
csharp_style_namespace_declarations = file_scoped:warning ;
csharp_using_directive_placement = outside_namespace:suggestion ;
csharp_style_prefer_primary_constructors = false

csharp_style_var_for_built_in_types = true
csharp_style_var_elsewhere = false
csharp_style_var_when_type_is_apparent = true