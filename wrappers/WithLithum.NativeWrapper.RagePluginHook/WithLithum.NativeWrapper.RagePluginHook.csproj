<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net4.8</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Title>Native Wrapper for GTA V (RPH version)</Title>
    <Company>WithLithum</Company>
    <Authors>WithLithum</Authors>
    <Product>$(SolutionName)</Product>
    <Description>Native Wrappers generated by NativeWrapperGen</Description>
    <Copyright>(C) WithLithum 2025.</Copyright>
    <PlatformTarget>x64</PlatformTarget>
    <PackageTags>shvdn;gta5;gta5-mods;scripthookvdotnet;shvdn3;scripthookvdotnet3</PackageTags>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageReadmeFile>PackReadme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="PackReadme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RagePluginHook" Version="1.124.0" />
  </ItemGroup>

</Project>
